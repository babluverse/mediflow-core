generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Doctor {
  id           String   @id
  userId       String   @unique
  specialty    String
  department   String
  availability String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  User         User     @relation(fields: [userId], references: [id])
}

model User {
  id        String   @id
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Doctor    Doctor?
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
  STAFF
}
