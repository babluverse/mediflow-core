generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor?
  tokens    Token[]
}

model Doctor {
  id           String   @id @default(cuid())
  userId       String   @unique
  specialty    String
  department   String
  availability String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tokens      Token[]
}

model Token {
  id           String      @id @default(cuid())
  tokenNumber  Int
  patientId    String
  departmentId String
  status       TokenStatus @default(WAITING)
  bookedAt     DateTime    @default(now())
  calledAt     DateTime?
  completedAt  DateTime?
  department   Department  @relation(fields: [departmentId], references: [id])
  patient      User        @relation(fields: [patientId], references: [id])
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
  STAFF
}

enum TokenStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
